 /**
  * Binary dictionary for faster deserialization
  * @ingroup opencc_cpp_api
diff --git a/src/DartsDict.cpp b/src/DartsDict.cpp
--- a/src/DartsDict.cpp
+++ b/src/DartsDict.cpp
@@ -234,20 +234,19 @@ DartsDictPtr DartsDict::NewFromFile(FILE* fp) {
